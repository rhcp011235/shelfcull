# shelfcull settings. Copy this file to .env and fill it in. Never commit your .env.

# --- Radarr: one or more. API key: Radarr > Settings > General > Security.
RADARR_1_URL=http://radarr:7878
RADARR_1_API_KEY=
RADARR_1_NAME=Movies
# Optional: where shelfcull can reach this Radarr's recycle bin (see README, "Recycle bin dates").
#RADARR_1_RECYCLE_BIN=/bins/radarr

# A second (third, ...) Radarr, for example a 4K instance:
#RADARR_2_URL=http://radarr-4k:7878
#RADARR_2_API_KEY=
#RADARR_2_NAME=Movies 4K

# --- Sonarr: optional, one or more. TV shows are removed as whole series.
#SONARR_1_URL=http://sonarr:8989
#SONARR_1_API_KEY=
#SONARR_1_NAME=TV

# --- Plex: optional, one or more. Gives "who watched it", the watched filters and the "Seen it" button.
# Token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
# Use the server owner's token: watch state is the owner's, and other users' plays come from the server history.
#PLEX_1_URL=http://plex:32400
#PLEX_1_TOKEN=
#PLEX_1_NAME=Plex

# --- Protect the page. Anyone who can open it can delete from your library.
AUTH_USER=admin
AUTH_PASSWORD=

# --- What "Remove" does
# true = go through all the motions but delete nothing (the log shows what would be removed). Start with this.
DRY_RUN=true
# Delete the files too (false = only remove the entry from Radarr / Sonarr).
DELETE_FILES=true
# Add an import list exclusion so the title is not added again by a list.
ADD_EXCLUSION=true
# A title that is in several Radarrs (or several Sonarrs) is removed from all of them, and excluded in all of them.
ALL_INSTANCES=true
# After a removal: ask Plex to scan its movie / TV libraries, and optionally empty the Plex trash when the scan is done.
PLEX_SCAN_AFTER_DELETE=true
PLEX_EMPTY_TRASH=false

# --- Other
# Rebuild the list this often (new downloads show up after a rebuild).
REFRESH_MINUTES=60
# LISTEN=0.0.0.0
# PORT=8765
# DATA_DIR=./data
# HTTP_TIMEOUT=120
# Set to false only for Radarr / Sonarr / Plex behind a self-signed certificate.
# VERIFY_TLS=true
